dist/
dist-ssr/
build/
.vite/
*.tsbuildinfo

# Кэш линтеров и тестов
.eslintcache
.stylelintcache
.cache/

# -------------------- Логи --------------------
logs/
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*
lerna-debug.log*

# -------------------- Переменные окружения --------------------
.env
.env.*
!.env.example

# -------------------- Python / Django (на будущее) --------------------
__pycache__/
*.py[cod]
*$py.class
*.so
.Python
build/
develop-eggs/
dist/
downloads/
eggs/
.eggs/
lib/
lib64/
parts/
sdist/
var/
wheels/
share/python-wheels/
